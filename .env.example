# Server
NODE_ENV=development
PORT=3011
ALLOWED_ORIGINS=*
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# HZPay Gateway
HZPAY_BASE_URL=https://api.hzpay.968.run
HZPAY_MERCHANT_ID=1701282757001
HZPAY_SECRET_KEY=YOUR_SECRET_HERE
HZPAY_VERSION=1.0
HZPAY_SIGN_TYPE=SHA512
HZPAY_TIMEOUT_MS=30000
HZPAY_RETRY_COUNT=3
HZPAY_DEFAULT_PAY_TYPE=101

# Callbacks (must be publicly reachable)
NOTIFY_URL=https://hzpay.rollix777.com/api/payment/webhook
PAYOUT_NOTIFY_URL=https://hzpay.rollix777.com/api/payout/webhook
RETURN_URL=https://your-app.com/
HZPAY_NOTIFY_URL=
HZPAY_PAYOUT_NOTIFY_URL=

# MySQL (shared platform DB — same as SkillPay/EinPay/AeroPay)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skillpay
DB_LOGGING=false
DB_SYNC_LOG_TABLES=true

# Platform (Rollix777)
PLATFORM_BASE_URL=https://api.rollix777.com
WALLET_BONUS_MULTIPLIER=1.10

# Logging
LOG_LEVEL=info
